# PhotoSift Configuration
PORT=3000
DB_PATH=/app/data/photos.db
TARGET_DIR=/target
INPUT_DIR=/input
DUPLICATES_DIR=/duplicates
INDEXER_THROTTLE_MS=500

# HEIC Conversion Settings
HEIC_AUTO_CONVERT=false  # Set to 'true' to convert HEIC to JPEG, 'false' to store as-is
HEIC_CONVERT_QUALITY=90  # JPEG quality (1-100, higher = better quality but larger files)